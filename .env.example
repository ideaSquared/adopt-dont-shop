# =============================================================================
# Adopt Don't Shop - Root Environment Configuration
# =============================================================================
# Quick start:
#   1. Copy this file to .env (or let `pnpm bootstrap` do it for you).
#   2. `pnpm bootstrap` auto-generates every secret below, including
#      POSTGRES_PASSWORD — you don't need to hand-write any of those.
#   3. You're only responsible for any third-party API keys you actually
#      use. Everything else has a working dev default.
#
# This file only carries the essentials. Every other variable the stack
# reads — per-service ports/schemas, S3/CloudFront, Statsig, Sentry/GlitchTip,
# Loki/OTel, gateway rate limits, seed volume knobs, backups, deploy — is
# documented with the file that reads it and its default in
# docs/env-reference.md. Add any of those keys to your .env only if you need
# to override the default.
#
# NEVER commit .env to version control. For production, use strong unique
# secrets (a secrets manager, not hand-typed values).
# =============================================================================
#
# =============================================================================
# REQUIRED — must be set before `pnpm docker:dev`
# =============================================================================
# Everything between this banner and the OPTIONAL banner is required. `pnpm
# bootstrap` generates every secret in it, including POSTGRES_PASSWORD, so
# there is no value you have to hand-write.
#
#   * NODE_ENV
#   * POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   * DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD
#   * DEV_DB_NAME / TEST_DB_NAME / PROD_DB_NAME (per-NODE_ENV)
#   * JWT_SECRET / JWT_REFRESH_SECRET / SESSION_SECRET (auto-generated)
#   * ENCRYPTION_KEY (auto-generated)
#   * REDIS_PASSWORD / GF_SECURITY_ADMIN_PASSWORD (auto-generated; Docker
#     Compose refuses to start without them — enforced by the docker:dev preflight)
#
# A CI guard (`scripts/check-env-example.mjs`) keeps this list in sync with
# `scripts/validate-env.ts` — add new required vars there and re-run
# `pnpm check:env-example` locally before pushing.

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (Postgres) — see docs/env-reference.md for DB_POOL_MAX
# -----------------------------------------------------------------------------
POSTGRES_USER=adopt_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IMMEDIATELY
POSTGRES_DB=adopt_dont_shop_dev

# The backend selects ONE of DEV_DB_NAME / TEST_DB_NAME / PROD_DB_NAME based
# on NODE_ENV — there is no generic DB_NAME variable (ADS-409/452/465).
# NODE_ENV defaults to `development`, so the dev stack reads DEV_DB_NAME.
#
# DB_HOST=database is the Docker Compose hostname. For native `pnpm dev`
# (no Docker) set DB_HOST=localhost — and REDIS_HOST=localhost /
# REDIS_PORT=6380 below, the port `pnpm dev:services` publishes Redis on.
DB_HOST=database
DB_PORT=5432
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DEV_DB_NAME=${POSTGRES_DB}
TEST_DB_NAME=adopt_dont_shop_test
PROD_DB_NAME=adopt_dont_shop_prod

# -----------------------------------------------------------------------------
# Auto-generated secrets — `pnpm bootstrap` / `pnpm secrets:generate` replace
# every placeholder below. Safe to leave as-is if you're running `pnpm bootstrap`.
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_STRONG_RANDOM_SECRET
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SESSION_SECRET
# Must be exactly 64 hex characters (32 bytes) for AES-256 — generate with
# `pnpm secrets:generate`, don't hand-write it.
ENCRYPTION_KEY=CHANGE_ME_RUN_pnpm_secrets:generate
# REDIS_PASSWORD is required by docker-compose.yml (ADS-600) — Compose
# refuses to start without it.
REDIS_PASSWORD=CHANGE_THIS_SECURE_REDIS_PASSWORD
# Grafana admin password (docker-compose.yml `observability`/`full`
# profiles) — Compose refuses to start Grafana without it (ADS-968).
GF_SECURITY_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_PASSWORD

# =============================================================================
# OPTIONAL — change only if you know why
# =============================================================================
# Everything below has a working dev default (or is generated by `pnpm
# bootstrap`). Compose already wires the microservices' own ports, schemas
# and gRPC URLs — see the commented sections at the end of this file.

# -----------------------------------------------------------------------------
# Gateway HTTP port. Only `pnpm validate:env` reads PORT; the gateway listens
# on GATEWAY_PORT (default 4000) and each microservice on its own *_PORT
# (5001-5010) supplied by Compose — see docs/env-reference.md.
# -----------------------------------------------------------------------------
PORT=4000

# -----------------------------------------------------------------------------
# Redis — see docs/env-reference.md for REDIS_HOST_PORT / REDIS_URL overrides
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Other auto-generated secrets — also filled in by `pnpm bootstrap`
# -----------------------------------------------------------------------------
# Dedicated HMAC key for short-lived /uploads-signed/* URLs (ADS-542).
UPLOAD_SIGNING_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_UPLOAD_SIGNING_SECRET
# Signs internal gRPC principal tokens (ADS-800) so services verify a
# caller's identity instead of trusting spoofable x-user-* headers. Optional
# in development/test only — every other environment refuses to boot
# without it (ADS-1050/ADS-1237).
PRINCIPAL_SIGNING_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_PRINCIPAL_SIGNING_KEY
# Signs read-only report-share JWTs. Optional — if missing, report sharing
# is silently disabled.
JWT_REPORT_SHARE_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_REPORT_SHARE_SECRET

# -----------------------------------------------------------------------------
# Frontend API configuration — used by all three apps (client/admin/rescue)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_BASE_URL=ws://localhost:4000

# Backend Frontend URLs (ADS-410: used to build password-reset /
# email-verification / invitation links — REQUIRED IN PRODUCTION, or every
# email link is broken).
FRONTEND_URL=http://localhost:3000
RESCUE_FRONTEND_URL=http://localhost:3002
ADMIN_FRONTEND_URL=http://localhost:3001

# Gateway self-URL (used in email/webhook callbacks). Required in production.
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# CORS — every SPA origin that calls the gateway directly, comma-separated
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost,http://admin.localhost,http://rescue.localhost,http://api.localhost,http://localhost:4000

# -----------------------------------------------------------------------------
# Email — dev default prints to console. See docs/env-reference.md for
# Resend (the only production provider actually wired in) and the worker /
# channel toggles.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@adoptdontshop.com
DEFAULT_FROM_EMAIL=noreply@adoptdontshop.com

# -----------------------------------------------------------------------------
# File storage — dev default is local disk. See docs/env-reference.md for
# the S3 + CloudFront vars.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# AV / malware scanning (ADS-1241) — clamd (ClamAV daemon). Every upload's
# bytes are scanned before they reach storage. Defaults already match the
# `clamav` docker-compose service, so these only need setting to point at a
# different scanner. CLAMAV_FAIL_OPEN lets an upload through when the
# scanner is unreachable instead of rejecting it — dev/local convenience
# only; the gateway hard-enforces fail-closed under NODE_ENV=production
# regardless of this value.
# -----------------------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_OPEN=false

# -----------------------------------------------------------------------------
# Development options — see docs/operations/dev-seed-data.md
# -----------------------------------------------------------------------------
# Password assigned to every seeded persona (`pnpm db:seed`). Synthetic
# `pnpm db:spam` users use SPAM_PASSWORD (same default).
SEED_PASSWORD=DevPassword123!

# --- Microservices (Compose supplies these; set only for bare-metal runs) ---
# Each service reads <SVC>_PORT / <SVC>_GRPC_PORT / <SVC>_HOST / <SVC>_SCHEMA
# from services/<name>/src/config.ts; the gateway reads every <SVC>_GRPC_URL.
# Defaults (HTTP 5001-5010, gRPC 6001-6010, schema = service name) are in
# docs/env-reference.md.
# DATABASE_URL=postgresql://adopt_user:<password>@localhost:5432/adopt_dont_shop_dev
# NATS_URL=nats://localhost:4222
# GATEWAY_PORT=4000
# AUTH_PORT=5002
# AUTH_GRPC_PORT=6002
# AUTH_SCHEMA=auth
# AUTH_GRPC_URL=localhost:6002
# PETS_GRPC_URL=localhost:6003

# --- Observability (opt-in) ---
# All inert when unset. Local dev: `pnpm docker:dev --profile full`.
# LOKI_URL=http://loki:3100
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_SERVICE_NAME=service-gateway
# SENTRY_DSN=http://<publicKey>@glitchtip-web:8080/<projectId>
# VITE_SENTRY_DSN=
# VITE_STATSIG_CLIENT_KEY=client-...
# Host .env only (prod/staging): deploy.yml adds the overlays when true.
# OBSERVABILITY_ENABLED=true
# GLITCHTIP_ENABLED=true
# GLITCHTIP_SECRET_KEY=
# GLITCHTIP_DB_PASSWORD=

# --- Backups ---
# GitHub repo variables consumed by backup.yml / backup-restore-drill.yml.
# BACKUP_BUCKET=my-backup-bucket
# AWS_REGION=eu-west-2

# --- Deploy ---
# Host .env only. deploy.yml / rollback.yml write DEPLOY_SHA; the prod and
# staging compose files refuse to start without it.
# DEPLOY_SHA=<git sha>
# Operator shell variable for the runbooks' curl commands (not read by code).
# PROD_HOSTNAME=example.com
# =============================================================================
