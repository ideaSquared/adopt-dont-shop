{
  "consumer": {
    "name": "service.notifications"
  },
  "messages": [
    {
      "contents": {
        "ipAddress": "203.0.113.7",
        "userAgent": "Mozilla/5.0",
        "userId": "usr-001"
      },
      "description": "auth.userLoggedIn event",
      "matchingRules": {
        "body": {
          "$.ipAddress": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.userAgent": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.userId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "a user signs in from a known IP address and browser"
        }
      ]
    },
    {
      "contents": {
        "assignedBy": "usr-admin",
        "reason": "Joined the rescue team",
        "role": "rescue_staff",
        "targetUserId": "usr-001"
      },
      "description": "auth.roleAssigned event",
      "matchingRules": {
        "body": {
          "$.assignedBy": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.reason": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.role": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.targetUserId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "an admin assigns a role with a reason"
        }
      ]
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "service.auth"
  }
}
