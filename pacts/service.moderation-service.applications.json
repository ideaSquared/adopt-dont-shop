{
  "consumer": {
    "name": "service.moderation"
  },
  "messages": [
    {
      "contents": {
        "adopterId": "usr-adopter",
        "applicationId": "app-001",
        "whyAdopt": "Send a deposit by wire transfer to reserve him today."
      },
      "description": "applications.submitted event with a why-adopt answer",
      "matchingRules": {
        "body": {
          "$.adopterId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.applicationId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.whyAdopt": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "an adopter submits an application with a why-adopt answer"
        }
      ]
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "service.applications"
  }
}
