{
  "consumer": {
    "name": "service.moderation"
  },
  "messages": [
    {
      "contents": {
        "longDescription": "Send a deposit by wire transfer to reserve him today.",
        "petId": "pet-001",
        "rescueId": "rescue-001",
        "shortDescription": "Friendly lab"
      },
      "description": "pets.created event with descriptions",
      "matchingRules": {
        "body": {
          "$.longDescription": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.petId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.rescueId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.shortDescription": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "a rescue lists a pet with descriptions"
        }
      ]
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "service.pets"
  }
}
