{
  "consumer": {
    "name": "service.notifications"
  },
  "messages": [
    {
      "contents": {
        "fromStatus": "available",
        "petId": "pet-001",
        "rescueId": "rescue-001",
        "toStatus": "pending"
      },
      "description": "pets.statusChanged event",
      "matchingRules": {
        "body": {
          "$.fromStatus": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.petId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.rescueId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.toStatus": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "a rescue moves an available pet to pending"
        }
      ]
    },
    {
      "contents": {
        "petId": "pet-001",
        "rescueId": "rescue-001"
      },
      "description": "pets.deleted event",
      "matchingRules": {
        "body": {
          "$.petId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.rescueId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "a rescue deletes a pet"
        }
      ]
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "service.pets"
  }
}
