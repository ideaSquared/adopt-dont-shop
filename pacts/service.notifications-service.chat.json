{
  "consumer": {
    "name": "service.notifications"
  },
  "messages": [
    {
      "contents": {
        "body": "Is Rex still available?",
        "chatId": "chat-001",
        "messageId": "msg-001",
        "participantUserIds": ["usr-staff"],
        "senderUserId": "usr-adopter"
      },
      "description": "chat.messageCreated event",
      "matchingRules": {
        "body": {
          "$.body": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.chatId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.messageId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.participantUserIds": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type",
                "min": 1
              }
            ]
          },
          "$.senderUserId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "an adopter sends a message in a chat with rescue staff"
        }
      ]
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "service.chat"
  }
}
