# syntax=docker/dockerfile:1.7-labs
#
# ONE dev image shared by every app and service in the docker-compose dev stack.
#
# It bakes a full workspace `pnpm install` (the standard, isolated symlink
# layout) so dependencies resolve EXACTLY as pnpm intends — workspace packages
# (@adopt-dont-shop/*), binaries (vite/tsx/turbo), and native modules
# (sharp/rolldown) all in their correct places, built for THIS image's platform.
#
# At runtime the dev stack bind-mounts the host SOURCE over /app for HMR, but
# re-exposes the image's node_modules through anonymous volumes (see
# docker-compose.dev.yml) so the host's node_modules — whose pnpm symlinks are
# absolute HOST paths that don't exist in the container — never leak in.
#
# Debian slim (glibc), NOT alpine (musl): vite 8 / rolldown and sharp ship
# native bindings that resolve to the glibc variant at runtime; on alpine/musl
# they fail with MODULE_NOT_FOUND. Matches the production app image.
#
# Network only touches the registry during `pnpm install` at BUILD time. The
# entry script (scripts/docker-dev.mjs) pulls a prebuilt image from GHCR first
# and only builds locally as a fallback, so most developers never run this.

# Pinned by digest (matches node:22.23.1-slim at the time of pinning) so a
# rebuild can't silently pull a different image. Renovate's docker manager
# (pinDigests: true in renovate.json) keeps this current — bump NODE_VERSION
# and the digest together when it opens a PR. [ADS-881]
ARG NODE_VERSION=22.23.1
FROM node:${NODE_VERSION}-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS development

# curl + wget: container healthchecks (services use curl, the app healthchecks
# in the base compose use wget). dumb-init: clean signal forwarding for the watch
# processes (tsx watch / vite). git: some postinstalls / tooling expect it.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget dumb-init git \
    && rm -rf /var/lib/apt/lists/*

# Non-root dev user [ADS-881]. The base node image already ships a `node`
# user/group at uid/gid 1000, so we reuse it rather than creating our own
# (a `groupadd -g 1000` would collide with the baked `node` group and fail
# the build). scripts/docker-dev-entrypoint.sh renumbers `node` at container
# start to match the host developer's real uid/gid (passed via
# HOST_UID/HOST_GID from scripts/docker-dev.mjs), then drops root before
# running the dev command. See that script for the full rationale — in short,
# the baked node_modules (installed as root below) are re-exposed at runtime
# through anonymous volumes, and the bind-mounted host source needs a
# matching uid to stay writable (e.g. lib.types' `tsc --watch` dist/ output),
# so a single fixed uid baked at build time can't work across every host.

WORKDIR /app

ENV HUSKY=0
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

# --- Dependency layer -----------------------------------------------------
# Copy ONLY what pnpm needs to resolve the workspace graph — the root manifests
# plus every workspace package.json (globs mirror pnpm-workspace.yaml). This is
# the industry-standard ordering (and what Dockerfile.service already does):
# the expensive `pnpm install` layer then keys on the lockfile + manifests
# alone, so it's a cache HIT whenever only source changed. That reuse is what
# lets CI's gha cache — and the GHCR image scripts/docker-dev.mjs pulls — stand
# in for a from-scratch install. `--parents` preserves each file's directory so
# the workspace layout is intact for install. A BuildKit cache mount keeps the
# pnpm store warm across rebuilds so a lockfile change re-links fast.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY --parents ./apps/*/package.json ./packages/*/package.json ./services/*/package.json ./e2e/package.json ./
RUN --mount=type=cache,id=pnpm-dev-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline --store-dir=/pnpm/store

# --- Source layer ---------------------------------------------------------
# The rest of the workspace. At runtime the `.:/app` bind mount replaces this
# baked source with the host's live source (HMR) and anon volumes re-expose the
# baked node_modules (see docker-compose.dev.yml), so this copy only makes the
# image runnable standalone (e.g. CI). Crucially it no longer sits ABOVE the
# install step, so a source-only change rebuilds just this cheap layer.
COPY . .

# dumb-init (PID 1, signal forwarding) -> our entrypoint script (still root:
# renumbers the `node` user to the host uid/gid, chowns the anon-volume
# node_modules paths, then setpriv-execs the real command as `node`). Invoked
# via `sh` rather than relying on the executable bit, since at runtime this
# path resolves through the `.:/app` bind mount to the HOST's copy of the file
# [ADS-881].
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/bin/sh", "/app/scripts/docker-dev-entrypoint.sh"]
