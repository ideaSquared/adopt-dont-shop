{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "schedule:earlyMondays",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies", "DevEx"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Group all non-major devDependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "devDependencies (non-major)"
    },
    {
      "description": "Group TypeScript ESLint packages",
      "matchPackageNames": ["/^@typescript-eslint//"],
      "groupName": "typescript-eslint"
    },
    {
      "description": "Group Vitest packages",
      "matchPackageNames": ["vitest", "/^@vitest//"],
      "groupName": "vitest"
    },
    {
      "description": "Group React types. The customManager below also updates these packages' pnpm.overrides pins (package.json), which force the resolved version — without it a React-group bump changes only the range and drifts from the override (see overridesDocumentation.react, ADS-1111).",
      "matchPackageNames": ["@types/react", "@types/react-dom", "react", "react-dom"],
      "groupName": "react"
    },
    {
      "description": "Automerge minor/patch devDeps when CI is green",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Pin GitHub Action SHAs",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Pin Docker base image digests and keep them current",
      "matchManagers": ["docker", "dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "description": "Prioritise vulnerability-fix PRs ahead of routine updates",
      "matchPackageNames": ["*"],
      "isVulnerabilityAlert": true,
      "prPriority": 10
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the React pnpm.overrides pins (react, react-dom, @types/react, @types/react-dom) updated alongside the react group. These exact pins force the resolved version for dedup (overridesDocumentation.react/@types/react); the built-in npm manager only sees the app range bumps, so without this the override drifts silently (ADS-1111).",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": [
        "\"(?<depName>react|react-dom|@types/react|@types/react-dom)\"\\s*:\\s*\"(?<currentValue>[\\^~]?\\d[^\"]*)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security", "DevEx"],
    "automerge": false,
    "prConcurrentLimit": 0
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Monday"]
  }
}
