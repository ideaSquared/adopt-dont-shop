{
  "name": "@adopt-dont-shop/eslint-config-node",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "description": "Shared ESLint configuration for Node.js backend services",
  "main": "index.js",
  "type": "module",
  "private": true,
  "keywords": [
    "eslint",
    "eslintconfig",
    "node"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"*.js\"",
    "format:check": "prettier --check \"*.js\""
  },
  "dependencies": {
    "@adopt-dont-shop/eslint-config-base": "workspace:*"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.1.3"
  }
}
