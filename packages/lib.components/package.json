{
  "name": "@adopt-dont-shop/lib.components",
  "version": "1.0.0",
  "description": "Shared component library for Adopt Don't Shop applications",
  "main": "dist/adopt-dont-shop-components.es.js",
  "module": "dist/adopt-dont-shop-components.es.js",
  "types": "dist/index.d.ts",
  "license": "AGPL-3.0-only",
  "type": "module",
  "style": "dist/adopt-dont-shop-components.css",
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/adopt-dont-shop-components.es.js"
    },
    "./umd": "./dist/adopt-dont-shop-components.umd.js",
    "./theme": {
      "import": "./dist/theme.es.js",
      "types": "./theme.d.ts"
    },
    "./styles": "./dist/adopt-dont-shop-components.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.d.ts"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "dev:server": "vite --port 3010 --mode development",
    "build": "rimraf dist && vite build && tsc -p tsconfig.build.json && vite build --config vite.theme.config.ts",
    "build:types": "tsc --emitDeclarationOnly",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "clean": "rimraf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@adopt-dont-shop/lib.types": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@adopt-dont-shop/eslint-config-react": "workspace:*",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/react": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "rimraf": "^6.1.4",
    "storybook": "^10.6.8",
    "vite": "^8.3.8",
    "vitest-axe": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  }
}
