{
  // Program behind `pnpm type-check`: the build program plus its test files.
  // Kept apart from tsconfig.json because that file drives the build, whose
  // rootDir/outDir must stay src -> dist and which must not emit tests. rootDir
  // is the repo root only because vitest-globals.d.ts lives there; nothing is emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "incremental": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "tsBuildInfoFile": null
  },
  "include": ["src/**/*", "../../vitest-globals.d.ts"],
  "exclude": ["node_modules", "dist"]
}
