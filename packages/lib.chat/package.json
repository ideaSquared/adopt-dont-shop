{
  "name": "@adopt-dont-shop/lib.chat",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Real-time chat and messaging functionality",
  "type": "module",
  "main": "dist/index.js",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "keywords": [
    "pet-adoption",
    "library",
    "typescript",
    "react"
  ],
  "author": "Adopt Don't Shop Team",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@adopt-dont-shop/lib.api": "workspace:*",
    "@adopt-dont-shop/lib.types": "workspace:*",
    "date-fns": "^4.3.0",
    "lucide-react": "^1.79.0",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@adopt-dont-shop/eslint-config-react": "workspace:*",
    "@adopt-dont-shop/lib.components": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vanilla-extract/css": "^1.21.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "peerDependencies": {
    "@adopt-dont-shop/lib.api": "workspace:*",
    "@adopt-dont-shop/lib.components": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^8.5.2",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideaSquared/adopt-dont-shop.git",
    "directory": "lib.chat"
  },
  "bugs": {
    "url": "https://github.com/ideaSquared/adopt-dont-shop/issues"
  },
  "homepage": "https://github.com/ideaSquared/adopt-dont-shop/tree/main/lib.chat#readme"
}
